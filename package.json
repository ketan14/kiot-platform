{
  "name": "kiot-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @kiot/api dev",
    "dev:worker": "pnpm --filter @kiot/device-worker dev",
    "dev:notify": "pnpm --filter @kiot/notification-worker dev",
    "dev:gateway": "pnpm --filter @kiot/gateway-agent dev",
    "dev:ws": "pnpm --filter @kiot/websocket-gateway dev",
    "dev:industrial": "pnpm --filter @kiot/industrial-app dev",
    "dev:cold": "pnpm --filter @kiot/cold-app dev",
    "dev:energy": "pnpm --filter @kiot/energy-app dev",
    "dev:home": "pnpm --filter @kiot/home-app dev",
    "dev:customer-admin": "pnpm --filter @kiot/customer-admin-app dev",
    "dev:platform-admin": "pnpm --filter @kiot/platform-admin-app dev",
    "dev:simulator": "pnpm --filter @kiot/device-simulator dev",
    "sim:device": "pnpm --filter @kiot/device-simulator start",
    "sim:telemetry": "pnpm --filter @kiot/device-worker exec tsx ../../scripts/simulate-industrial-telemetry.ts",
    "qa:check": "./scripts/qa-checks.sh",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "start": "./scripts/start.sh",
    "stop": "./scripts/stop.sh",
    "setup:lan": "./scripts/setup-lan.sh",
    "docker:up": "./scripts/start-docker.sh",
    "docker:down": "./scripts/stop-docker.sh",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.dev.yml logs -f",
    "db:migrate": "./scripts/migrate-db.sh",
    "db:seed": "./scripts/seed-db.sh",
    "db:reset": "./scripts/migrate-db.sh --reset && ./scripts/seed-db.sh",
    "db:psql": "docker exec -it kiot-postgres-dev psql -U postgres -d kiot_dev",
    "db:tables": "docker exec kiot-postgres-dev psql -U postgres -d kiot_dev -c '\\dt'"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "prettier": "^3.4.2"
  }
}

