# ==============================================================================
# KIOT Platform - Environment Variables Template
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_ENV=development

# Database Connection (PostgreSQL 16 + TimescaleDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiot_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/kiot_dev

# Supabase Auth / Local Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# EMQX Broker Configuration
EMQX_HOST=localhost
EMQX_PORT=1883
EMQX_TLS_PORT=8883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
EMQX_ADMIN_USER=admin
EMQX_ADMIN_PASSWORD=kiotadmin123

# Redis Configuration (Pub/Sub & Cache)
REDIS_URL=redis://localhost:6380

# API Service
PORT=3000
API_URL=http://localhost:3000
WS_URL=ws://localhost:3001

